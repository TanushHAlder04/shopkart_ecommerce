# ==============================================================================
# ShopKart E-Commerce Environment Configuration (.env.example)
# Duplicate this file as .env or .env.local and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & CURRENCY SETTINGS
# ------------------------------------------------------------------------------
# Default currency symbol displayed across the storefront, cart, and checkout
NEXT_PUBLIC_CURRENCY_SYMBOL='$'

# ------------------------------------------------------------------------------
# 2. ROLE-BASED ACCESS CONTROL (RBAC)
# ------------------------------------------------------------------------------
# Comma-separated list of administrative email addresses (matches Clerk user email)
ADMIN_EMAIL=admin@example.com,superadmin@example.com

# ------------------------------------------------------------------------------
# 3. CLERK AUTHENTICATION
# ------------------------------------------------------------------------------
# Public Clerk publishable key for client-side authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret Clerk key for backend authentication and JWT verification
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Clerk redirect routing (defaults to modal / standard Clerk paths)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# 4. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase)
# ------------------------------------------------------------------------------
# Pooled connection string for serverless query routing (PgBouncer / Neon pooler)
DATABASE_URL="postgresql://user:password@ep-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection string for Prisma CLI migrations and schema push
DIRECT_URL="postgresql://user:password@ep-direct.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 5. INNGEST EVENT SYSTEM & BACKGROUND WORKERS
# ------------------------------------------------------------------------------
# Inngest event transmission and signing keys for reliable async jobs (user sync, coupon expiry)
INNGEST_EVENT_KEY=your_inngest_event_key_here
INNGEST_SIGNING_KEY=signkey-prod-your_inngest_signing_key_here

# ------------------------------------------------------------------------------
# 6. IMAGEKIT CLOUD STORAGE & CDN
# ------------------------------------------------------------------------------
# ImageKit credentials for secure media upload, optimization, and transformation
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ------------------------------------------------------------------------------
# 7. STRIPE & STRIPE CONNECT (PAYMENTS & SELLER PAYOUTS)
# ------------------------------------------------------------------------------
# Stripe secret API key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Stripe webhook signing secret (starts with whsec_) for validating Stripe webhook payloads
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 8. UPSTASH REDIS (RATE LIMITING & CACHING)
# ------------------------------------------------------------------------------
# Upstash REST API endpoint and token for serverless sliding-window rate limiting
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
